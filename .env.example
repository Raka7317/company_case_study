# --- Storage / Database ---
DATABASE_URL=sqlite:///./storage/app.db
UPLOAD_DIR=./storage/uploads

# --- Document constraints ---
MAX_PAGES=3
OCR_MIN_NATIVE_CHARS=40

# --- OCR ---
TESSERACT_CMD=tesseract

# --- Optional: LLM-based extraction (falls back to rule-based if unset) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Financial validation tolerance ---
VALIDATION_TOLERANCE=1.0
VALIDATION_TOLERANCE_PCT=0.01

LOG_LEVEL=INFO
